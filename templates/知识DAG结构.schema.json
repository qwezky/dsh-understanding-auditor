{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "知识点 DAG（理解审计员 v1.2）",
  "type": "object",
  "required": [
    "graph_id",
    "version",
    "nodes",
    "edges",
    "components"
  ],
  "properties": {
    "graph_id": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "const": "1.2"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "report_span": {
      "type": "string"
    },
    "summary_root": {
      "type": [
        "string",
        "null"
      ],
      "description": "仅展示，不参与考察"
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "text",
          "kind",
          "origin",
          "parents",
          "children"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "claim",
              "term",
              "reason",
              "evidence",
              "conclusion"
            ]
          },
          "origin": {
            "type": "string",
            "enum": [
              "human",
              "ai"
            ]
          },
          "origin_basis": {
            "type": "string"
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "level": {
            "type": "integer",
            "minimum": 0
          },
          "risk": {
            "type": "string",
            "enum": [
              "high",
              "mid",
              "low"
            ]
          },
          "cluster_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "SCC 折叠后的概念簇 id"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "citation",
                  "textbook",
                  "author",
                  "none"
                ]
              },
              "ref": {
                "type": "string"
              }
            }
          },
          "assumed_known": {
            "type": "boolean",
            "description": "人类提出的祖先默认会，不耗题"
          },
          "provenance": {
            "type": "string",
            "enum": [
              "user_source",
              "user_note",
              "ai_summary",
              "external",
              "unknown"
            ]
          },
          "ai_variant": {
            "type": "boolean",
            "description": "同一概念另有 AI 版本，进入抽查池"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type"
        ],
        "properties": {
          "from": {
            "type": "string",
            "description": "前置"
          },
          "to": {
            "type": "string",
            "description": "后继"
          },
          "type": {
            "type": "string",
            "enum": [
              "prereq"
            ]
          }
        }
      }
    },
    "cycles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "node_ids"
        ],
        "properties": {
          "cluster_id": {
            "type": "string"
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2
          }
        }
      }
    },
    "non_prereq_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "contrast",
              "example",
              "supports"
            ]
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "entry_ids",
          "node_ids",
          "status"
        ],
        "properties": {
          "component_id": {
            "type": "string"
          },
          "entry_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "status": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "unchecked",
                  "in_progress",
                  "simple_pass",
                  "simple_fail",
                  "normal_pass",
                  "normal_fail",
                  "needs_human"
                ]
              },
              "asked": {
                "type": "integer",
                "minimum": 0
              },
              "skipped": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "refilled": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reasked": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "spot_checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "node_id",
                    "result"
                  ],
                  "properties": {
                    "node_id": {
                      "type": "string"
                    },
                    "result": {
                      "type": "string",
                      "enum": [
                        "pass",
                        "fail",
                        "not_drawn"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "dial": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "深度旋钮：题量/抽查率/判定严格度"
    }
  }
}